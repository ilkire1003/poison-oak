#!/bin/bash
#     mkdir -p logs && bsub < hpc/poisonoak_smoketest.lsf
#     This is a Week-1-Day-1 smoke test only: confirms HPC/GPU access and a
#     working CUDA torch build. It does not train anything yet, since the
#     PoisonOak repo/pipeline code doesn't exist yet. Swap in the real
#     phase0.py-style call once that exists, following this same pattern.
#     Compute nodes don't keep installed libraries between jobs, so every run
#     reinstalls from requirements.txt (pip's cache makes repeat runs fast).
#BSUB -J poisonoak_smoketest
#BSUB -q gpua100                  # GPU queue -- CUDA required for all backbone jobs
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=16GB]"
#BSUB -W 0:30
#BSUB -B
#BSUB -N
#BSUB -u s245146@dtu.dk
#BSUB -o logs/smoketest_%J.out
#BSUB -e logs/smoketest_%J.err
set -euo pipefail

cd ~/PoisonOak
mkdir -p logs

if [ ! -d .venv ]; then
    echo "no .venv found -- creating one"
    python3 -m venv .venv
fi
source .venv/bin/activate
pip install --upgrade pip
pip install -r requirements.txt

echo "Job ${LSB_JOBID:-?} started $(date) on $(hostname)"
python -c "import torch; print('cuda available:', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"
echo "Job finished $(date)"
